# Variables de entorno del backend — TaskFlow Scrum
# Copia este archivo a `.env` y ajusta los valores. NUNCA subas `.env` al repositorio.

# --- Base de datos (PostgreSQL) ---
DB_URL=jdbc:postgresql://localhost:5432/tododb
DB_USERNAME=todouser
DB_PASSWORD=todopass

# --- Servidor ---
SERVER_PORT=8080

# --- CORS (origen del frontend en desarrollo) ---
CORS_ALLOWED_ORIGINS=http://localhost:5173
